{
  "name": "@proslotbosllc/powered-by",
  "version": "1.1.0",
  "description": "The \"Powered by ProSlot BOS\" footer credit, as one component and one HTML-string renderer, so the live page and the pre-rendered markup can never disagree.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./static-routes": {
      "types": "./dist/staticRoutes.d.ts",
      "import": "./dist/staticRoutes.js",
      "require": "./dist/cjs/staticRoutes.js",
      "default": "./dist/staticRoutes.js"
    },
    "./package.json": "./package.json"
  }
}
